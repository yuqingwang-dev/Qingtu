# Database
POSTGRES_DB=qingtu
POSTGRES_VOLUME_NAME=qingtu_postgres_data
REDIS_VOLUME_NAME=qingtu_redis_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qingtu

# Backend
DEBUG=True
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_SECRET_KEY=dev-session-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Redis / cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_HEAVY_ENDPOINTS=10
# Daily generation quota. Set False for local testing; keep True in production.
# Independent from RATE_LIMIT_ENABLED (per-minute throttling).
GENERATION_LIMIT_ENABLED=True

# AI / RAG
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_TOKENS=12000
AGENT_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_ENABLED=False
RAG_TOP_K=50
# Reviewed travel-document RAG: local Chinese model, separate from legacy RAG.
KNOWLEDGE_VECTOR_ENABLED=True
KNOWLEDGE_MODEL_CACHE=.cache/models
USE_ORTOOLS=True

# TripPilot Phase 1.1 — Provider contracts (non-breaking, default off)
USE_PROVIDER_ADAPTER=False
PROVIDER_CACHE_TTL_SECONDS=3600

# Google APIs
GOOGLE_PLACES_API_KEY=
AMAP_WEB_SERVICE_KEY=
LIVE_POI_ENABLED=True
POI_CACHE_TTL_SECONDS=3600
POI_MAX_RESULTS=36
POI_TIMEOUT_SECONDS=8
ROUTE_MAX_REQUESTS=100
ROUTE_CACHE_TTL_SECONDS=900
ROUTE_TIMEOUT_SECONDS=90
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-me

# WebSocket / collaboration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_SESSION=5
COLLAB_SESSION_TIMEOUT_MINUTES=120

# Background jobs
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging / monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
